# Registry fetch headroom for pnpm (issue #255, NFR-25). registry.npmjs.org's
# advisory-bulk endpoint (used by `pnpm audit`) has intermittently timed out
# under pnpm's defaults (fetch-retries=2, fetch-timeout=60000), failing CI's
# `Required (Security)` gate on PRs that touch no dependency manifest at all.
# Raised here, at the repo root, so pnpm picks it up for every install and
# audit under frontend/ (pnpm walks up from the cwd), not just CI's audit
# step. fetch-retry-mintimeout/-maxtimeout are left at pnpm's defaults - see
# .github/workflows/security.yml's frontend-audit job for the worst-case
# wall-time budget these two settings feed into.
fetch-timeout=90000
fetch-retries=3
