{
  "realm": "nptc",
  "enabled": true,
  "displayName": "National Pathology Test Catalogue",
  "sslRequired": "external",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "verifyEmail": false,
  "identityProviders": [],
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "permanentLockout": false,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    }
  ],
  "browserFlow": "nptc browser",
  "authenticationFlows": [
    {
      "alias": "nptc browser",
      "description": "issue #44 (NFR-06): browser flow, OTP conditional on requested LoA, not on TOTP being configured. See ADR-0019 and ADR-0021.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-spnego",
          "requirement": "DISABLED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "nptc browser forms",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "nptc browser forms",
      "description": "Two conditional subflows, one per level of authentication: password satisfies LoA 1, OTP satisfies LoA 2 (issues #44/#41, NFR-06/NFR-02).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "nptc browser forms conditional password",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "nptc browser forms conditional otp",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "nptc browser forms conditional password",
      "description": "issue #41 (NFR-02): username/password, satisfying LoA 1. Conditional, not a bare REQUIRED step - without a satisfiable LoA 1, Keycloak resolves every request to the flow's highest level and demands OTP of every user.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticatorConfig": "nptc loa-1 condition"
        },
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "nptc browser forms conditional otp",
      "description": "issue #44 (NFR-06): OTP REQUIRED when acr_values requests LoA 2+. loa-condition-level=2 matches AuthSettings.mfa_acr_values's default.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticatorConfig": "nptc loa-2 condition"
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "nptc loa-1 condition",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "nptc loa-2 condition",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "36000"
      }
    }
  ],
  "clients": [
    {
      "clientId": "nptc-frontend",
      "name": "NPTC frontend",
      "description": "The public SPA (issue #41). Public client, PKCE-only - there is no secret to leak.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "rootUrl": "${NPTC_FRONTEND_BASE_URL}",
      "baseUrl": "${NPTC_FRONTEND_BASE_URL}",
      "redirectUris": ["${NPTC_FRONTEND_BASE_URL}/*"],
      "webOrigins": ["${NPTC_FRONTEND_BASE_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${NPTC_FRONTEND_BASE_URL}"
      },
      "defaultClientScopes": ["basic", "profile", "email", "web-origins"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "nptc-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "nptc-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nptc-api",
      "name": "NPTC API",
      "description": "Audience target only (issue #43) - never logged into. Every flow disabled; public so there is no secret field at all.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "attributes": {
    "acr.loa.map": "{\"1\": 1, \"2\": 2}"
  }
}
