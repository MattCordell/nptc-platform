{
  "realm": "nptc",
  "enabled": true,
  "displayName": "National Pathology Test Catalogue",
  "sslRequired": "external",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "verifyEmail": false,
  "identityProviders": [],
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "permanentLockout": false,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "nptc-frontend",
      "name": "NPTC frontend",
      "description": "The public SPA (issue #41). Public client, PKCE-only - there is no secret to leak.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "rootUrl": "${NPTC_FRONTEND_BASE_URL}",
      "baseUrl": "${NPTC_FRONTEND_BASE_URL}",
      "redirectUris": ["${NPTC_FRONTEND_BASE_URL}/*"],
      "webOrigins": ["${NPTC_FRONTEND_BASE_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${NPTC_FRONTEND_BASE_URL}"
      },
      "defaultClientScopes": ["basic", "profile", "email", "web-origins"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "nptc-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "nptc-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nptc-api",
      "name": "NPTC API",
      "description": "Audience target only (issue #43) - never logged into. Every flow disabled; public so there is no secret field at all.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ]
}
