# Copy this file to deploy/.env and fill in real values before running
# `docker compose -f deploy/compose.yml up`. No real values here (NFR-26) -
# this file is the only committed dotenv (see .gitignore).
#
# Every variable the stack reads is documented here and kept in step with
# docs/operations/configuration.md as later issues add services that read
# more of them.

# --- Postgres ---
POSTGRES_USER=nptc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nptc
# Host port Postgres is published on. Change if 5432 is already in use.
POSTGRES_PORT=5432

# --- Backend database access (issue #33) ---
# Read by nptc.settings.DatabaseSettings/MigrationSettings, not by compose.
# Two separate DSNs for two separate roles, and two separate settings
# classes so an operator running a migration never needs to set both - see
# docs/operations/upgrade.md and docs/architecture/data-model.md.
# The app runtime role (nptc_app membership only: INSERT/SELECT on
# audit_event, no UPDATE/DELETE/TRUNCATE - NFR-09). No default: a missing
# value must fail loudly naming the variable, never silently fall back to a
# placeholder (NFR-26).
NPTC_DATABASE_URL=postgresql+psycopg://nptc_app_login:change-me@localhost:5432/nptc
# The owning role Alembic runs migrations as (CREATE EXTENSION, CREATE ROLE,
# GRANT/REVOKE all require more than nptc_app has). Typically POSTGRES_USER
# itself in this local stack.
NPTC_MIGRATION_DATABASE_URL=postgresql+psycopg://nptc:change-me@localhost:5432/nptc

# --- Audit chain verification CLI (issue #38) ---
# Read by nptc.settings.AuditVerifySettings and scripts/verify_audit_chain.py.
# Optional - empty falls back to NPTC_DATABASE_URL above. Only ever SELECTs,
# so point this at a read-only replica or a restored backup rather than the
# app runtime's own DSN. See docs/operations/runbooks/verify-audit-chain.md.
#NPTC_AUDIT_VERIFY_DATABASE_URL=postgresql+psycopg://nptc_app_login:change-me@localhost:5432/nptc

# --- Filterable-property index reconciliation (issue #54, FR-13) ---
# Read by nptc.settings.IndexerSettings and
# scripts/reconcile_property_indexes.py. Optional - empty means
# reconciliation is disabled (a valid, safe posture, unlike the two DSNs
# above: this settings class never raises on a missing value). Never
# NPTC_MIGRATION_DATABASE_URL (too broad - CREATE ROLE/DROP TABLE) or
# NPTC_DATABASE_URL (the app role cannot do DDL at all) - a role that can
# CREATE/DROP INDEX on property_value only. See
# docs/operations/upgrade.md#provisioning-the-index-reconcilers-login-issue-54-fr-13
# and docs/operations/runbooks/reconcile-property-indexes.md.
#NPTC_INDEXER_DATABASE_URL=postgresql+psycopg://nptc_indexer:change-me@localhost:5432/nptc

# --- Server-side JWT verification (issue #43, NFR-07) ---
# Read by nptc.settings.AuthSettings. Empty NPTC_OIDC_ISSUER is fail-closed:
# TokenVerifier.from_settings refuses to construct at all rather than accept
# a token whose issuer was never checked. See
# docs/architecture/token-verification.md.
NPTC_OIDC_ISSUER=http://localhost:8080/realms/nptc
# Fixed by the committed realm's nptc-api-audience mapper (ADR-0014) - only
# change alongside a realm change.
NPTC_OIDC_AUDIENCE=nptc-api
# Empty means resolve via OIDC discovery against NPTC_OIDC_ISSUER. Set only
# for an air-gapped deployment that cannot reach a discovery endpoint.
NPTC_JWKS_URL=
NPTC_JWKS_CACHE_SECONDS=300
NPTC_JWKS_REFRESH_COOLDOWN_SECONDS=30

# --- Permission framework (issue #44, NFR-06) ---
# Comma-separated acr claim values satisfying mandatory-MFA-for-administrators
# (nptc.auth.principal.principal_for). Must match the committed realm's
# "nptc loa-2 condition" authenticator config. See
# docs/architecture/permissions.md.
NPTC_MFA_ACR_VALUES=2

# --- Keycloak ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Host port Keycloak's HTTP listener is published on.
KEYCLOAK_PORT=8080
# Resolved into deploy/keycloak/realm/nptc-realm.json's ${NPTC_FRONTEND_BASE_URL}
# placeholder at import (issue #40, ADR-0014) - the frontend client's
# redirect URIs, web origins and post-logout redirect all derive from this
# one value. Change it to the frontend's real origin in a non-local
# deployment; recreate the keycloak container (not just restart) for an
# edited realm file to take effect - see
# docs/operations/configuration.md#keycloak-realm-import.
NPTC_FRONTEND_BASE_URL=http://localhost:5173

# --- Frontend (Vite build-time) ---
# The only variables Vite inlines into the published bundle. Both are public
# facts about a public OIDC client (ADR-0021), never secrets: `pnpm build`
# runs scripts/assert-no-secret-in-bundle.mjs over dist/ and fails if a
# secret-shaped value ever reaches the built assets (NFR-01).
#
# NEVER add a VITE_* variable holding a credential - Vite inlines every one
# of them as a literal, so it would be published to every visitor.
#
# The issuer must be reachable from the *browser*, not from the API
# container: it is the URL the user is redirected to.
VITE_OIDC_ISSUER=http://localhost:8080/realms/nptc
# Must match the realm's public client (deploy/keycloak/realm/nptc-realm.json).
VITE_OIDC_CLIENT_ID=nptc-frontend

# --- Terminology (Ontoserver) ---
# Read by nptc_shared.terminology (backend and transform), not by compose.
# Base URL of the FHIR terminology server. FR-53 keeps this configurable so the
# stack can be repointed at NCTS production or a self-hosted Ontoserver.
NPTC_TX_BASE_URL=https://tx.ontoserver.csiro.au/fhir
# Optional static bearer token. Empty means anonymous, which is what
# tx.ontoserver.csiro.au accepts. Never commit a real value (NFR-26).
NPTC_TX_TOKEN=
NPTC_TX_TIMEOUT_SECONDS=30
NPTC_TX_MAX_RETRIES=3
# Batch validation sweep (FR-52). Codes per ValueSet/$expand in the bulk status
# pass, and the concurrency ceiling on the targeted $lookup pass that follows
# it. Both are untuned defaults inside the range the PRD specifies - see
# docs/adr/0005-sweep-chunk-size-and-concurrency-defaults.md before changing
# them, and raise the concurrency only with the server operator's knowledge.
NPTC_TX_CHUNK_SIZE=300
NPTC_TX_MAX_CONCURRENCY=4
