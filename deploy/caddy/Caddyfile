# Serves the built SPA and reverse-proxies the API, so the browser sees one
# origin and CORS never applies (ADR-0001, ADR-0020). HTTP only: TLS and HSTS
# belong to the production overlay.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Vite fingerprints everything under /assets/, so an existing file can be
	# cached for good. A missing one must 404 rather than fall back to
	# index.html, or a stale hashed URL would cache the wrong document for a year.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# index.html names the fingerprinted files, so it is fetched every time.
		header Cache-Control "no-cache"
		# TanStack Router runs in browser-history mode, so a deep link such as
		# /admin/catalogue has no file behind it. Falling back to index.html
		# hands the path to the router; without this a refresh returns 404.
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		# SAMEORIGIN, not DENY: silent renewal and step-up load /auth/callback
		# in a hidden iframe on this same origin. Other sites may not frame us.
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
