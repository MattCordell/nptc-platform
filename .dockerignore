# Build context for backend/Dockerfile and frontend/Dockerfile is the repo root.
# Keep secrets, local state and other machines' build output out of it.
.git
.github
.claude
.venv
.mypy_cache
.ruff_cache
.pytest_cache
**/__pycache__
**/node_modules
frontend/dist
docs
# frontend/src/catalogue/limits.test.ts imports this file, and `tsc -b` in the
# frontend build type-checks tests.
!docs/api/openapi.json

# Every real dotenv; only *.env.example is meant to be read.
.env
**/.env
**/*.tsbuildinfo
frontend/coverage
